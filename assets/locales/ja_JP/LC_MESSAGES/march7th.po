#: app/main_window.py:1027
msgid "运行任务时会自动在设备上启动游戏"
msgstr "タスクを実行すると、デバイス上でゲームが自動的に起動します"

#: app/setting_interface.py:1030
msgid "Android 设备设置"
msgstr "Android デバイス設定"

#: app/setting_interface.py:2940
msgid "安卓设备"
msgstr "Android デバイス"

#: app/setting_interface.py:3091
msgid "请先停止任务，再切换设备后端"
msgstr "タスクを停止してからデバイスバックエンドを切り替えてください"

#: app/setting_interface.py:3106
msgid "环境检查会占用设备，请等任务结束后再检查"
msgstr "環境チェックはデバイスを占有します。タスクの終了後に実行してください"

#: app/tools/adb_service.py:142
msgid ""
"手机上会弹出“允许 USB 调试吗？”，勾选“一律允许”后点“确定”。没有弹窗时重新插拔数据线，或在开发者选项里点“撤销 USB 调试授权”后再连接。"
msgstr ""
"端末に「USB "
"デバッグを許可しますか？」が表示されます。「常に許可する」にチェックを入れて「OK」を押してください。表示されない場合はケーブルを挿し直すか、開発者向けオプションで「USB"
" デバッグの許可の取り消し」を押してから接続し直してください。"

#: app/tools/adb_service.py:145
msgid ""
"安装 Android Platform-Tools 并把它加入 PATH，或在“高级设置”里指定 adb 的位置。装有 MuMu "
"等模拟器时会自动使用模拟器自带的 adb。"
msgstr ""
"Android Platform-Tools をインストールして PATH に追加するか、「詳細設定」で adb の場所を指定してください。MuMu "
"などのエミュレーターがインストールされている場合は、付属の adb が自動的に使われます。"

#: app/tools/adb_service.py:147
msgid ""
"电脑上还有另一个版本的 adb（常见于模拟器和手机助手）在抢占服务端。关闭这些程序，或在“高级设置”里把 adb 路径改成它们使用的那一个，然后重试。"
msgstr ""
"この PC では別バージョンの adb（エミュレーターやスマホ管理ソフトに多い）が ADB "
"サーバーを奪い合っています。それらのプログラムを終了するか、「詳細設定」の adb のパスをそれらが使うものに合わせてから再試行してください。"

#: app/tools/adb_service.py:149
msgid "adb 没有响应。重新插拔数据线或重启模拟器后重试。"
msgstr "adb が応答しません。ケーブルを挿し直すかエミュレーターを再起動してから再試行してください。"

#: app/tools/adb_service.py:150
msgid "adb 命令执行失败。重新插拔数据线或重启模拟器后重试。"
msgstr "adb コマンドの実行に失敗しました。ケーブルを挿し直すかエミュレーターを再起動してから再試行してください。"

#: app/tools/adb_service.py:151
msgid ""
"用数据线连接手机，并在开发者选项里打开“USB 调试”。模拟器请在“Android 设备”里输入地址连接，MuMu 默认是 "
"127.0.0.1:16384。"
msgstr ""
"ケーブルで端末を接続し、開発者向けオプションで「USB デバッグ」を有効にしてください。エミュレーターは「Android "
"デバイス」でアドレスを入力して接続します。MuMu の既定値は 127.0.0.1:16384 です。"

#: app/tools/adb_service.py:153
msgid "检测到多台设备，请在“Android 设备”里选择要使用的那一台。"
msgstr "複数のデバイスが見つかりました。「Android デバイス」で使用するデバイスを選んでください。"

#: app/tools/adb_service.py:154
msgid "设备已连接但还不能使用。重新插拔数据线或重启模拟器，然后点“刷新”。"
msgstr "デバイスは接続されていますが、まだ使用できません。ケーブルを挿し直すかエミュレーターを再起動してから「更新」を押してください。"

#: app/tools/adb_service.py:155
msgid "ADB 模式需要 Android 10 或更高版本，请换一台设备，或改用模拟器。"
msgstr "ADB モードには Android 10 以降が必要です。別のデバイスかエミュレーターを使用してください。"

#: app/tools/adb_service.py:156
msgid "读不到设备的屏幕分辨率。解锁设备并保持亮屏后重试。"
msgstr "デバイスの画面解像度を読み取れません。ロックを解除して画面を点灯したまま再試行してください。"

#: app/tools/adb_service.py:157
msgid "请在“高级设置”里重新选择设备类型。"
msgstr "「詳細設定」でデバイスの種類を選び直してください。"

#: app/tools/adb_service.py:158
msgid "在模拟器设置里把分辨率改成 1280×720（横屏、240 DPI），重启模拟器后重试。"
msgstr "エミュレーターの設定で解像度を 1280×720（横向き、240 DPI）に変更し、エミュレーターを再起動してから再試行してください。"

#: app/tools/adb_service.py:159
msgid "这台模拟器的 Android 版本低于 14，不能直接使用模拟器画面。请在“高级设置”里把设备类型改回“自动判断”。"
msgstr ""
"このエミュレーターの Android は 14 "
"未満のため、エミュレーターの画面を直接使用できません。「詳細設定」でデバイスの種類を「自動判定」に戻してください。"

#: app/tools/adb_service.py:161
msgid "在设备上安装国服《崩坏：星穹铁道》，并先手动登录一次账号。"
msgstr "デバイスに中国本土版の『崩壊：スターレイル』をインストールし、一度手動でログインしてください。"

#: app/tools/adb_service.py:162
msgid ""
"缺少设备端服务文件。请重新解压完整的程序包；从源码运行时先在 Android 目录执行 gradlew :device-"
"service:assemble。"
msgstr ""
"デバイスサービスのファイルがありません。完全なパッケージを展開し直してください。ソースから実行する場合は、先に Android フォルダーで "
"gradlew :device-service:assemble を実行してください。"

#: app/tools/adb_service.py:164
msgid "设备正被另一个任务占用，或上一次运行还在收尾。等十几秒后重试；有任务在运行时先等它结束。"
msgstr "デバイスは別のタスクが使用中か、前回の実行の後処理中です。十数秒待って再試行してください。タスクが実行中の場合は終了を待ってください。"

#: app/tools/adb_service.py:166
msgid "设备端服务没能启动。重新插拔数据线后重试，仍然失败时重启设备。"
msgstr "デバイスサービスを起動できませんでした。ケーブルを挿し直して再試行し、それでも失敗する場合はデバイスを再起動してください。"

#: app/tools/adb_service.py:167
msgid "设备端服务和本程序的版本不一致，请把程序更新到最新版本后重试。"
msgstr "デバイスサービスと本アプリのバージョンが一致しません。アプリを最新バージョンに更新してから再試行してください。"

#: app/tools/adb_service.py:169
msgid "系统拒绝了触摸注入。小米、红米手机请在开发者选项里打开“USB 调试（安全设置）”，其他品牌请打开名称相近的开关，然后重新插拔数据线。"
msgstr ""
"システムがタッチ入力を拒否しました。Xiaomi・Redmi 端末は開発者向けオプションで「USB "
"デバッグ（セキュリティ設定）」を有効にしてください。他のメーカーは似た名前のスイッチを有効にし、ケーブルを挿し直してください。"

#: app/tools/adb_service.py:171
msgid "在手机屏幕或模拟器窗口里完成登录，然后重新运行任务。登录界面这时留在手机屏幕上是正常现象。"
msgstr ""
"端末の画面またはエミュレーターのウィンドウでログインを済ませてから、タスクを再実行してください。このときログイン画面が端末の画面に残るのは正常です。"

#: app/tools/adb_service.py:173
msgid "设备连接断开了。检查数据线，或确认模拟器还在运行，重新连接后再运行任务。"
msgstr "デバイスとの接続が切れました。ケーブルを確認するか、エミュレーターが起動しているか確認し、再接続してからタスクを実行してください。"

#: app/tools/adb_service.py:174
msgid "游戏进程被关闭了，可能是系统清理了后台。请把游戏加入自启动和省电白名单，不要在最近任务里一键清理，然后重新运行任务。"
msgstr ""
"ゲームのプロセスが終了しました。システムがバックグラウンドを整理した可能性があります。ゲームを自動起動と省電力の除外リストに追加し、最近のタスクで一括クリアをしないようにしてから、タスクを再実行してください。"

#: app/tools/adb_service.py:176
msgid "游戏没能回到虚拟屏。请在设备上结束游戏，然后重新运行任务。"
msgstr "ゲームを仮想ディスプレイに戻せませんでした。デバイスでゲームを終了してから、タスクを再実行してください。"

#: app/tools/adb_service.py:177
msgid "游戏没有在限定时间内进入主界面。请确认账号已登录、网络正常，必要时先在设备上手动进入一次游戏。"
msgstr ""
"ゲームが制限時間内にメイン画面に入りませんでした。アカウントがログイン済みでネットワークが正常か確認し、必要であれば一度デバイスで手動でゲームに入ってください。"

#: app/tools/adb_service.py:179
msgid "长时间取不到新的游戏画面。请确认设备没有锁屏，然后重新运行任务。"
msgstr "長時間、新しいゲーム画面を取得できません。デバイスがロックされていないことを確認してから、タスクを再実行してください。"

#: app/tools/adb_service.py:180
msgid "这个任务只能在本地或云游戏后端运行，请切换设备后端后再运行。"
msgstr "このタスクはローカルまたはクラウドゲームのバックエンドでのみ実行できます。デバイスバックエンドを切り替えてから実行してください。"

#: app/tools/adb_service.py:181
msgid "请在 Android 设备上通过游戏自带的更新流程更新游戏。"
msgstr "Android デバイス上で、ゲーム自体の更新手順でゲームを更新してください。"

#: app/tools/adb_service.py:182
msgid "ADB 模式不能代替你输入文字，请在设备上手动输入。"
msgstr "ADB モードでは文字を代わりに入力できません。デバイス上で手動で入力してください。"

#: app/tools/adb_service.py:183
msgid "请在本页把设备后端重新选择为“Android 设备（ADB）”。"
msgstr "このページでデバイスバックエンドを「Android デバイス（ADB）」に選び直してください。"

#: app/tools/adb_service.py:184
msgid "请在“高级设置”里把点按时长改为 1 到 10000 毫秒之间的整数。"
msgstr "「詳細設定」でタップ時間を 1〜10000 ミリ秒の整数に変更してください。"

#: app/tools/adb_service.py:186
msgid "请按提示处理后重试。仍然失败时，把日志页的内容发给开发者。"
msgstr "メッセージに従って対処してから再試行してください。それでも失敗する場合は、ログページの内容を開発者に送ってください。"

