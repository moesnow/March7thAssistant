#: app/card/uac_free_setting_card.py:85
msgid "免 UAC 运行已开启"
msgstr "Execution without UAC prompts enabled"

#: app/card/uac_free_setting_card.py:95
msgid "免 UAC 运行已关闭"
msgstr "Execution without UAC prompts disabled"

#: app/setting_interface.py:2507
msgid "免 UAC 运行"
msgstr "Run Without UAC Prompts"

#: app/setting_interface.py:2508
msgid "开启后，AI 助手或脚本通过 m7a.exe 运行任务时不再弹出 UAC 确认，适合让 AI 助手远程运行任务"
msgstr ""
"When enabled, AI assistants and scripts can run tasks through m7a.exe "
"without UAC confirmation, allowing an AI assistant to run tasks remotely"

