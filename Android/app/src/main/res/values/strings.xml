    <!-- 权限引导 -->
    <string name="guide_title">权限引导</string>
    <string name="guide_intro">小助手需要更高的权限才能创建后台虚拟屏并替你点按游戏。选一种方式，按步骤完成一次即可。</string>
    <string name="guide_locked">任务运行期间不能切换权限方式。</string>
    <string name="guide_shizuku_heading">通过 Shizuku 授权</string>
    <string name="guide_shizuku_about">不需要 Root，适合大多数手机。</string>
    <string name="guide_root_heading">通过 Root 授权</string>
    <string name="guide_root_about">设备已经 Root 时可以用，不需要 Shizuku。</string>
    <string name="guide_install_title">安装 Shizuku</string>
    <string name="guide_install_detail">Shizuku 是开源的授权工具。到它的官方发布页下载最新版 APK 并安装，装好后回到这里。</string>
    <string name="guide_install_done">已安装</string>
    <string name="guide_start_title">启动 Shizuku 服务</string>
    <string name="guide_start_pending">安装后再启动服务</string>
    <string name="guide_start_done">服务正在运行</string>
    <string name="guide_this_device">本机是 Android %1$s，按下面的方式启动</string>
    <string name="guide_start_usb">1. 在「开发者选项」里打开「USB 调试」。\n2. 用数据线连接电脑，电脑上需要有 adb。\n3. 打开 Shizuku，在「通过连接电脑启动」里点「查看指令」，在电脑上执行那条命令。\n4. Shizuku 显示「正在运行」后就可以拔掉数据线。</string>
    <string name="guide_start_usb_reboot">Android 10 不支持无线调试。每次重启手机后，都要连电脑重新启动一次 Shizuku。</string>
    <string name="guide_start_wireless">1. 连接 Wi‑Fi，在「开发者选项」里打开「无线调试」。\n2. 打开 Shizuku，点「配对」，按通知里的提示输入无线调试的配对码。\n3. 回到 Shizuku 点「启动」，看到「正在运行」即可。</string>
    <string name="guide_start_wireless_reboot">全程不需要电脑。重启手机后，要回到 Shizuku 再点一次「启动」。</string>
    <string name="guide_other_wireless">Android 11 及以上怎么启动</string>
    <string name="guide_other_usb">Android 10 怎么启动</string>
    <string name="guide_grant_title">允许小助手使用 Shizuku</string>
    <string name="guide_grant_pending">服务运行后再授权</string>
    <string name="guide_grant_done">已授权</string>
    <string name="guide_grant_detail">点下面的按钮，在弹出的窗口里选「始终允许」。</string>
    <string name="guide_grant_hint">没有弹窗？打开 Shizuku 的「已授权应用」，手动打开三月七小助手的开关。</string>
    <string name="guide_root_check_title">检查并授予 Root 权限</string>
    <string name="guide_root_unchecked">点「检查 Root」确认设备是否已授权。</string>
    <string name="guide_root_denied">在 Root 管理应用（如 Magisk）里允许小助手使用 Root，再检查一次。</string>
    <string name="guide_root_missing">没有找到 su 命令，这台设备可能没有 Root。没有 Root 请改用 Shizuku。</string>
    <string name="guide_root_done">已获得 Root 权限</string>
    <string name="guide_root_experimental">Root 方式还没有在真机上完整验证。遇到问题请改用 Shizuku。</string>
    <string name="guide_ready_title">权限已就绪</string>
    <string name="guide_ready_detail">可以回到首页开始任务了。</string>
    <string name="guide_back_home">回到首页</string>
    <string name="guide_what_happens">运行时会发生什么</string>
    <string name="guide_happens_virtual">游戏在一块看不见的 1280×720 虚拟屏里运行，手机屏幕可以照常使用。</string>
    <string name="guide_happens_flash">每次启动游戏，登录界面都会把游戏带到手机屏幕上闪现几秒，随后自动移回后台。这几秒先别碰屏幕，以免点进游戏里。</string>
    <string name="guide_happens_login">如果游戏停在登录界面等你输入账号，任务会停下来。先在手机上登录好，再重新开始。</string>
    <string name="guide_happens_account">运行期间不要在别的设备登录同一个账号，否则会被挤下线。</string>
    <string name="guide_stability">让任务跑得稳</string>
    <string name="guide_tip_miui">小米、Redmi 手机（MIUI / HyperOS）：在「开发者选项」里打开「USB 调试（安全设置）」，否则系统会拦截小助手的模拟点击。</string>
    <string name="guide_tip_lock">运行期间保持解锁，不要按电源键。锁屏或息屏后点按到不了游戏，任务会卡住。想关屏省电，请用设置里的「游戏就绪后关闭屏幕」。</string>
    <string name="guide_tip_clean">不要在最近任务里「一键清理」，它会把后台的游戏一起结束。</string>
    <string name="guide_tip_battery">把小助手和游戏的省电策略设为「无限制」并允许自启动，避免被系统中途结束。</string>
    <string name="guide_tip_notification">允许通知后，可以在通知栏看到进度并随时停止。</string>

